# TaskMesh Backend Configuration
# Copy this file to .env and update the values

# Database
DATABASE_URL=postgresql+asyncpg://taskmesh:taskmesh_secret@localhost:5432/taskmesh

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
SECRET_KEY=change-me-in-production-use-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Worker Settings
WORKER_CONCURRENCY=4
HEARTBEAT_INTERVAL=15
JOB_LEASE_SECONDS=300
MAX_RETRIES=3

# Queue Names
QUEUE_DEFAULT=jobs:default
QUEUE_HIGH=jobs:high
QUEUE_LOW=jobs:low
